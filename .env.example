# 复制为 .env 后填真值。必须 UTF-8 无 BOM（别用 PowerShell 的 Out-File 写）。

# deepseek | mimo
LLM_PROVIDER=deepseek

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# MiMo：接口信息拿到后填这三项，再把 LLM_PROVIDER 改成 mimo
# 注意：MIMO_BASE_URL 不要写成 https://user:token@host 这种内嵌凭据的写法
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=

# 飞书群 → 设置 → 添加机器人 → 自定义机器人
# ⚠️ 这条 URL 本身就是凭据，拿到的人能往你群里发消息。切勿提交、勿贴进聊天
FEISHU_WEBHOOK_URL=

# 仅当机器人开了「签名校验」才填；关键词/白名单/无校验则留空
FEISHU_SECRET=

# 可选。GitHub Search API 拿 AI 热门仓库用，不填则跳过该源。
# GitHub Actions 上会自动注入，无需配置；本地想要就填一个 PAT。
GITHUB_TOKEN=
